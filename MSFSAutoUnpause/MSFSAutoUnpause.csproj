<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net6.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>MSFSAutoUnpause</AssemblyName>
    <RootNamespace>MSFSAutoUnpause</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationIcon>icon.ico</ApplicationIcon>

    <!-- Release version: bump this for every Flightsim.to / GitHub release -->
    <Version>1.1.0</Version>
    <Product>MSFS Auto Unpause</Product>
    <Authors>ItzChickenYall</Authors>
    <Copyright>Copyright (c) 2025-2026 ItzChickenYall</Copyright>
    <!-- Keep the git commit hash out of the displayed version string -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- SimConnect managed wrapper (from MSFS 2024 SDK) -->
    <Reference Include="Microsoft.FlightSimulator.SimConnect">
      <HintPath>SimConnect\Microsoft.FlightSimulator.SimConnect.dll</HintPath>
    </Reference>
  </ItemGroup>

  <!-- Single-file publish only: keep SimConnect next to the exe instead of inside it.
       Microsoft.FlightSimulator.SimConnect.dll is a mixed-mode (C++/CLI) assembly, which
       cannot be loaded from inside a single-file bundle, and it loads the native
       SimConnect.dll from the exe's folder. No effect on normal builds. -->
  <Target Name="KeepSimConnectOutsideBundle" AfterTargets="ComputeResolvedFilesToPublishList" Condition="'$(PublishSingleFile)' == 'true'">
    <ItemGroup>
      <_KeepNextToExe Include="@(ResolvedFileToPublish)" Condition="'%(Filename)' == 'Microsoft.FlightSimulator.SimConnect' Or '%(Filename)' == 'SimConnect' Or '%(Filename)%(Extension)' == 'icon.ico'" />
      <ResolvedFileToPublish Remove="@(_KeepNextToExe)" />
      <ResolvedFileToPublish Include="@(_KeepNextToExe)" ExcludeFromSingleFile="true" />
    </ItemGroup>
  </Target>

  <!-- Copy icon and SimConnect to output -->
  <ItemGroup>
    <Content Include="icon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="SimConnect\SimConnect.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>SimConnect.dll</Link>
    </Content>
  </ItemGroup>

</Project>
